# Stellar Scope — Environment Configuration
# Copy this to .env and fill in your contract IDs
#
# Every setting is optional; commented values are the built-in defaults.
# dotenv reads .env from the directory the server is started in: prototype/
# for `npm start` here, the repo root for `node prototype/server.js` there.
# test/env-example.test.js fails if a setting the code reads is missing here,
# or if one listed here is no longer read.

# Server
PORT=4000

# History DB path. MUST be an absolute path pointing at a mounted volume in
# production, or the database lives on the container filesystem and every
# user-created profile and all snapshot history is discarded on each deploy.
# The resolved path is logged at boot — check it after a deploy. On Railway,
# /api/health reports historyDb.storage as "volume" or "ephemeral", and the
# boot log prints a WARNING whenever it is ephemeral.
# See the volume-cutover runbook in the hardening PR: the volume starts EMPTY,
# so the existing file has to be copied into it before switching this over.
# HISTORY_DB_PATH=/data/history.db

# ── Security ───────────────────────────────────────────────────────────────
# Extra allowed origins for the same-origin gate, comma separated. The
# production hostnames are built in; add preview-deploy origins here rather
# than editing code.
# ALLOWED_ORIGINS=https://my-preview.up.railway.app

# Number of trusted proxy hops in front of the app. Railway alone is 1; with
# Cloudflare ALSO in front it is 2. If this is too low, req.ip resolves to the
# proxy and every visitor shares a single 60-req/min rate-limit bucket.
# /api/health echoes the resolved clientIp so you can check against production.
# TRUST_PROXY_HOPS=1

# Send Content-Security-Policy-Report-Only instead of enforcing. Use on a
# preview deploy to collect violations before turning the policy on.
# CSP_REPORT_ONLY=1

# Accept profile-auth signatures made over sha256(message) as well as over the
# message itself. OFF by default and should stay off: a digest signature is
# indistinguishable from a signature over a 32-byte transaction hash, so any
# wallet that signs caller-supplied hashes becomes a signing oracle for the
# profile-ownership challenge. If a real wallet turns out to need this, the
# server logs "hash-variant WOULD have matched" on the failure path.
# PROFILE_AUTH_ALLOW_HASH_VARIANTS=1

# Domain baked into the signed profile-auth challenge message.
# STELLARSCOPE_DOMAIN=stellarscope.xyz

# Soroban RPC endpoint (default: gateway.fm mainnet)
SOROBAN_RPC_URL=https://soroban-rpc.mainnet.stellar.gateway.fm
# Transient RPC failures (429 / 5xx / network) are retried with jittered
# exponential backoff before an adapter sees the error.
# RPC_RETRY_ATTEMPTS=4
# RPC_RETRY_BASE_MS=250
# Per-adapter wall-clock budget; LP discovery gets its own, larger one.
# ADAPTER_TIMEOUT_MS=8000
# LP_DISCOVERY_TIMEOUT_MS=20000
# How long an adapter's last good result is served after it starts failing,
# so a slow RPC does not make a position vanish for one refresh (10 min).
# ADAPTER_STALE_TTL_MS=600000
# Parallel reads during LP discovery. Lower it if the RPC starts returning 429s.
# LP_DISCOVERY_CONCURRENCY=10

# Other upstreams
# HORIZON_URL=https://horizon.stellar.org
# STELLAR_EXPERT_API=https://api.stellar.expert/explorer/public
# SOROSWAP_TOKEN_LIST_URL=https://raw.githubusercontent.com/soroswap/token-list/main/tokenList.json

# ── Pricing and token discovery ───────────────────────────────────────────
# Price cache (1 min) and CoinGecko token price map refresh (6 h).
# PRICE_TTL_MS=60000
# PRICE_MAP_REFRESH_MS=21600000
# Soroban token universe: refresh (6 h), size cap, and whether to include
# stellar.expert's contract index (set false to skip it).
# UNIVERSE_REFRESH_MS=21600000
# UNIVERSE_MAX_SIZE=500
# UNIVERSE_INCLUDE_STELLAR_EXPERT=true
# Balance probes: parallelism, and cache times for zero (5 min) and non-zero
# (1 min) balances.
# DISCOVERY_PROBE_CONCURRENCY=20
# DISCOVERY_ZERO_CACHE_TTL_MS=300000
# DISCOVERY_NONZERO_CACHE_TTL_MS=60000
# AMM price layer (lib/soroswap-aggregator.js): the last pricing step for a
# token, read from its deepest Aquarius or Soroswap pool against USDC or XLM.
# The Aquarius router is AQUA_ROUTER_CONTRACT_ID below (defaults to mainnet's
# when empty).
# SOROSWAP_FACTORY_CONTRACT_ID=CA4HEQTL2WPEUYKYKCDOHCDNIV4QHNJ7EL4J4NQ6VADP7SYHVRYZ7AW2
# SOROSWAP_ROUTER_CONTRACT_ID=CAG5LRYQ5JVEUI5TEID72EYOVX44TTUJT5BQR2J6J77FH65PCCFAJDDH
# USDC_SAC_CONTRACT=CCW67TSZV3SSS2HXMBQ5JFGCKJNXKZM7UQUWUZPUTHXSTZLEO7SJMI75
# XLM_SAC_CONTRACT=CAS3J7GYLGXMF6TDJBBYYSE3HQ6BBSMLNUQ34T6TZMYMW2EVH34XOWMA
# A pool's USDC or XLM side must hold at least this much (USD) to be used.
# AMM_MIN_DEPTH_USD=10000

# ── Protocol explorer ─────────────────────────────────────────────────────
# Pools below this TVL (USD) are left out of the explorer.
# DEFI_EXPLORER_MIN_TVL_USD=250000

# ── K2 ────────────────────────────────────────────────────────────────────
# K2_ROUTER_CONTRACT=CCTUJZLYFAW7ZNQD2SXMUZIHBUUJJICYRKWLZJ6SK6TGNAWNXOJIV6J7

# ── Blend Protocol ─────────────────────────────────────────────────────────
# Blend lending pool contract IDs (JSON array). Added to the five pools built
# into lib/adapters/blend.js and the ones read from the pool factory.
# Example: [{"contractId":"CABC...","name":"Main Pool"}]
BLEND_POOLS=[]
# BLEND_POOL_FACTORY=CDSYOAVXFY7SM5S64IZPPPYB4GVGGLMQVFREPSQQEZVIWXX5R23G4QSU

# ── Aquarius (AQUA) ───────────────────────────────────────────────────────
# Off until AQUA_POOLS has a pool or the router or voting contract is set.
# With Solv also unset, /api/health lists 7 configured protocols, not 9.
# Aquarius AMM router contract (setting it also turns this adapter on; the
# AMM price layer uses mainnet's router whether or not it is set)
AQUA_ROUTER_CONTRACT_ID=
# AQUA token contract (for reward tracking)
AQUA_TOKEN_CONTRACT_ID=
# ICE governance token contract
ICE_TOKEN_CONTRACT_ID=
# AQUA voting/locking contract
AQUA_VOTING_CONTRACT_ID=
# Known Aquarius AMM pools (JSON array)
# Example: [{"contractId":"CABC...","type":"constant_product","tokens":[{"symbol":"XLM","contractId":"C...","decimals":7},{"symbol":"USDC","contractId":"C...","decimals":7}],"rewardGauge":"CDEF..."}]
AQUA_POOLS=[]

# ── SolvBTC Token Contracts ────────────────────────────────────────────────
# Get these from stellar.expert or the Solv Protocol docs
SOLVBTC_CONTRACT_ID=
SOLVBTC_BBN_CONTRACT_ID=

# ── Solv Protocol Vaults ───────────────────────────────────────────────────
# Off until a vault or staking contract is set or SOLV_LP_POOLS has a pool.
SOLV_VAULT_CONTRACT_ID=
SOLV_STAKING_CONTRACT_ID=

# Solv LP pools (JSON array)
# Example: [{"contractId":"CABC...","dex":"sushiswap-v3","token0":{"symbol":"SolvBTC","contractId":"C...","decimals":8},"token1":{"symbol":"USDC","contractId":"C...","decimals":7}}]
SOLV_LP_POOLS=[]
