# Stellar Scope — Environment Configuration
# Copy this to .env and fill in your contract IDs

# Server
PORT=4000

# History DB path. MUST be an absolute path pointing at a mounted volume in
# production, or the database lives on the container filesystem and every
# user-created profile and all snapshot history is discarded on each deploy.
# The resolved path is logged at boot — check it after a deploy.
# See the volume-cutover runbook in the hardening PR: the volume starts EMPTY,
# so the existing file has to be copied into it before switching this over.
# HISTORY_DB_PATH=/data/history.db

# ── Security ───────────────────────────────────────────────────────────────
# Extra allowed origins for the same-origin gate, comma separated. The
# production hostnames are built in; add preview-deploy origins here rather
# than editing code.
# ALLOWED_ORIGINS=https://my-preview.up.railway.app

# Number of trusted proxy hops in front of the app. Railway alone is 1; with
# Cloudflare ALSO in front it is 2. If this is too low, req.ip resolves to the
# proxy and every visitor shares a single 60-req/min rate-limit bucket.
# /api/health echoes the resolved clientIp so you can check against production.
# TRUST_PROXY_HOPS=1

# Send Content-Security-Policy-Report-Only instead of enforcing. Use on a
# preview deploy to collect violations before turning the policy on.
# CSP_REPORT_ONLY=1

# Accept profile-auth signatures made over sha256(message) as well as over the
# message itself. OFF by default and should stay off: a digest signature is
# indistinguishable from a signature over a 32-byte transaction hash, so any
# wallet that signs caller-supplied hashes becomes a signing oracle for the
# profile-ownership challenge. If a real wallet turns out to need this, the
# server logs "hash-variant WOULD have matched" on the failure path.
# PROFILE_AUTH_ALLOW_HASH_VARIANTS=1

# Domain baked into the signed profile-auth challenge message.
# STELLARSCOPE_DOMAIN=stellarscope.xyz

# Soroban RPC endpoint (default: gateway.fm mainnet)
SOROBAN_RPC_URL=https://soroban-rpc.mainnet.stellar.gateway.fm
# Transient RPC failures (429 / 5xx / network) are retried with jittered
# exponential backoff before an adapter sees the error.
# RPC_RETRY_ATTEMPTS=4
# RPC_RETRY_BASE_MS=250
# Per-adapter wall-clock budget; LP discovery gets its own, larger one.
# ADAPTER_TIMEOUT_MS=8000
# LP_DISCOVERY_TIMEOUT_MS=20000

# ── Blend Protocol ─────────────────────────────────────────────────────────
# Blend lending pool contract IDs (JSON array)
# Example: [{"contractId":"CABC...","name":"Main Pool"}]
BLEND_POOLS=[]

# ── Aquarius (AQUA) ───────────────────────────────────────────────────────
# Aquarius AMM router contract
AQUA_ROUTER_CONTRACT_ID=
# AQUA token contract (for reward tracking)
AQUA_TOKEN_CONTRACT_ID=
# ICE governance token contract
ICE_TOKEN_CONTRACT_ID=
# AQUA voting/locking contract
AQUA_VOTING_CONTRACT_ID=
# Known Aquarius AMM pools (JSON array)
# Example: [{"contractId":"CABC...","type":"constant_product","tokens":[{"symbol":"XLM","contractId":"C...","decimals":7},{"symbol":"USDC","contractId":"C...","decimals":7}],"rewardGauge":"CDEF..."}]
AQUA_POOLS=[]

# ── Templar Finance ───────────────────────────────────────────────────────
# Templar registry contract (discovers markets automatically)
TEMPLAR_REGISTRY_CONTRACT_ID=
# Known Templar markets (JSON array)
# Example: [{"contractId":"CABC...","name":"XLM → USDC","collateral":{"symbol":"XLM","contractId":"C...","decimals":7},"borrow":{"symbol":"USDC","contractId":"C...","decimals":7}}]
TEMPLAR_MARKETS=[]

# ── SolvBTC Token Contracts ────────────────────────────────────────────────
# Get these from stellar.expert or the Solv Protocol docs
SOLVBTC_CONTRACT_ID=
SOLVBTC_BBN_CONTRACT_ID=

# ── Solv Protocol Vaults ───────────────────────────────────────────────────
SOLV_VAULT_CONTRACT_ID=
SOLV_STAKING_CONTRACT_ID=

# Solv LP pools (JSON array)
# Example: [{"contractId":"CABC...","dex":"sushiswap-v3","token0":{"symbol":"SolvBTC","contractId":"C...","decimals":8},"token1":{"symbol":"USDC","contractId":"C...","decimals":7}}]
SOLV_LP_POOLS=[]

# ── SushiSwap V3 ──────────────────────────────────────────────────────────
SUSHI_FACTORY_CONTRACT_ID=

# Known Sushi V3 pools (JSON array)
# Example: [{"contractId":"CABC...","token0":{"contractId":"C...","symbol":"XLM","decimals":7},"token1":{"contractId":"C...","symbol":"USDC","decimals":7},"feeTier":3000}]
SUSHI_POOLS=[]
